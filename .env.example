# BKS Odisha website — local environment
#
# Copy this file to `.env.local` and fill values yourself.
# Never commit secrets. Never paste secret values into ChatGPT/Cursor chat.
#
# Shared BKS Supabase project (Bengal + Odisha schemas):
# https://lhnorkjfldywnrqqunqn.supabase.co
# Dashboard API keys:
# https://supabase.com/dashboard/project/lhnorkjfldywnrqqunqn/settings/api
#
# Odisha data lives in schema odisha_bks only — never write to Bengal tables.

NEXT_PUBLIC_SUPABASE_URL=https://lhnorkjfldywnrqqunqn.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Required for /admin/district-members mutations and photo upload.
# Never expose to the browser. Never put in NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=

# --- Odisha admin gate (this repo only) ---
# Long random string. Entered on /admin/district-members; sent as x-admin-key.
# Independent from Bengal's BKS_ADMIN_KEY — do not reuse that value here.
# Never hard-code. Never log. Never put in NEXT_PUBLIC_*.
ODISHA_BKS_ADMIN_KEY=
